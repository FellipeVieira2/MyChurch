{
	"info": {
		"_postman_id": "church-capacity-collection",
		"name": "MyChurch - Church Capacity & Infrastructure",
		"description": "Collection completa para gerenciar capacidade e infraestrutura da igreja\n\n**Funcionalidades:**\n- Atualizar lotação (assentos e em pé)\n- Gerenciar vagas de estacionamento\n- Configurar WiFi\n- Adicionar instalações (cafeteria, livraria, berçário)\n- Registrar equipamentos (som, projetor, ar-condicionado)\n- Instalações adicionais\n\n**Autenticação:**\nRequer JWT Token com role **Admin**.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "??? Capacity Management",
			"item": [
				{
					"name": "Update Full Capacity - Large Church",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"seatingCapacity\": 800,\n  \"standingCapacity\": 200,\n  \"parkingSpaces\": 150,\n  \"hasWifi\": true,\n  \"wifiPassword\": \"IgrejaWiFi2024\",\n  \"hasCafeteria\": true,\n  \"hasBookstore\": true,\n  \"hasNursery\": true,\n  \"hasSoundSystem\": true,\n  \"hasProjector\": true,\n  \"hasAirConditioning\": true,\n  \"hasBaptistery\": true,\n  \"additionalFacilities\": [\"Academia\", \"Quadra esportiva\", \"Auditório\", \"Sala de reuniões\"],\n  \"equipmentNotes\": \"Sistema de som profissional Yamaha. Projetor 4K. Ar-condicionado central.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/Church/capacity",
							"host": ["{{base_url}}"],
							"path": ["api", "Church", "capacity"]
						},
						"description": "Igreja grande com todas as instalações e equipamentos"
					},
					"response": []
				},
