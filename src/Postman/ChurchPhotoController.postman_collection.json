		{
			"name": "?? Like System",
			"item": [
				{
					"name": "Like Photo",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/ChurchPhoto/{{photo_id}}/like?like=true",
							"host": ["{{base_url}}"],
							"path": ["api", "ChurchPhoto", "{{photo_id}}", "like"],
							"query": [
								{
									"key": "like",
									"value": "true",
									"description": "true = curtir, false = descurtir"
								}
							]
						},
						"description": "Curtir uma foto (requer autenticação)"
					},
					"response": []
				},
				{
					"name": "Unlike Photo",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/ChurchPhoto/{{photo_id}}/like?like=false",
							"host": ["{{base_url}}"],
							"path": ["api", "ChurchPhoto", "{{photo_id}}", "like"],
							"query": [
								{
									"key": "like",
									"value": "false",
									"description": "Remover curtida"
								}
							]
						},
						"description": "Descurtir uma foto (remove o like)"
					},
					"response": []
				}
			],
			"description": "Sistema de curtidas (requer autenticação)"
		},
		{
			"name": "??? Delete Photos",
			"item": [
				{
					"name": "Delete Photo",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/ChurchPhoto/{{photo_id}}?churchId={{church_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "ChurchPhoto", "{{photo_id}}"],
							"query": [
								{
									"key": "churchId",
									"value": "{{church_id}}",
									"description": "ID da igreja (validação)"
								}
							]
						},
						"description": "Deleta uma foto (apenas admin ou autor podem deletar)"
					},
					"response": []
				}
			],
			"description": "Deletar fotos (requer permissão: admin ou autor da foto)"
		}
