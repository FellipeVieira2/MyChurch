				{
					"name": "Get All Photos - Church",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/ChurchPhoto/church/{{church_id}}?page=1&pageSize=20",
							"host": ["{{base_url}}"],
							"path": ["api", "ChurchPhoto", "church", "{{church_id}}"],
							"query": [
