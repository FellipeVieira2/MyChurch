		{
			"name": "?? Update Church Characteristics",
			"item": [
				{
					"name": "Update Characteristics - Complete",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"denomination\": \"Batista\",\n  \"coverPhoto\": \"https://s3.amazonaws.com/mybucket/cover-photo.jpg\",\n  \"hasParking\": true,\n  \"isAccessible\": true,\n  \"hasLiveStream\": true,\n  \"hasChildMinistry\": true,\n  \"languages\": [\"Português\", \"Inglês\"]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/Church/characteristics",
							"host": ["{{base_url}}"],
							"path": ["api", "Church", "characteristics"]
						},
						"description": "Atualiza todas as características da igreja (apenas Admin)"
					},
					"response": []
				},
