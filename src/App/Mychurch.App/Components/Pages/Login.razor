@page "/login"
@layout Mychurch.App.Components.Layout.EmptyLayout
@using Mychurch.App.Models
@using Mychurch.App.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div class="login-container">
    <div class="login-card">
        
        <!-- Logo e Título -->
        <div class="login-header">
            <div class="church-icon">
                <svg width="80" height="80" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <linearGradient id="churchGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#6366F1;stop-opacity:1" />
                            <stop offset="100%" style="stop-color:#8B5CF6;stop-opacity:1" />
                        </linearGradient>
                    </defs>
                    <circle cx="100" cy="100" r="95" fill="url(#churchGradient)" opacity="0.1"/>
                    <g fill="url(#churchGradient)">
                        <rect x="60" y="110" width="80" height="70" rx="4"/>
                        <polygon points="100,60 55,110 145,110"/>
                        <rect x="85" y="40" width="30" height="70" rx="2"/>
                        <polygon points="100,20 80,40 120,40"/>
                        <rect x="97" y="10" width="6" height="18" rx="1"/>
                        <rect x="92" y="15" width="16" height="6" rx="1"/>
                        <rect x="85" y="145" width="30" height="35" rx="15" fill="white"/>
                        <circle cx="75" cy="130" r="8" fill="white"/>
                        <circle cx="125" cy="130" r="8" fill="white"/>
                    </g>
                </svg>
            </div>
            <h1 class="app-title">MyChurch</h1>
            <p class="welcome-text">Bem-vindo(a) de volta</p>
        </div>

        <!-- Formulário -->
        <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />
            
            <!-- Campo Email/Telefone -->
            <div class="form-group">
                <label class="form-label">E-mail ou Telefone</label>
                <div class="input-group">
                    <span class="input-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </span>
                    <InputText 
                        @bind-Value="loginModel.Identifier"
                        class="form-input" 
                        placeholder="Digite seu e-mail ou telefone"
                        autocomplete="username"
                        disabled="@isLoading" />
                </div>
            </div>

            <!-- Campo Senha -->
            <div class="form-group">
                <label class="form-label">Senha</label>
                <div class="input-group">
                    <span class="input-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </span>
                    <InputText 
                        @bind-Value="loginModel.Password"
                        type="@(showPassword ? "text" : "password")"
                        class="form-input" 
                        placeholder="Digite sua senha"
                        autocomplete="current-password"
                        disabled="@isLoading" />
                    <button type="button" 
                            class="toggle-password" 
                            @onclick="TogglePasswordVisibility"
                            @onclick:preventDefault
                            disabled="@isLoading">
                        @if (showPassword)
                        {
                            <!-- Ícone Olho Aberto -->
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        }
                        else
                        {
                            <!-- Ícone Olho Fechado -->
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <!-- Mensagem de erro -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle; margin-right: 8px;">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="8" x2="12" y2="12"></line>
                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                    </svg>
                    @errorMessage
                </div>
            }

            <!-- Link Esqueceu a senha -->
            <div class="forgot-password">
                <a href="#" @onclick="@(() => ShowAlert("Funcionalidade em desenvolvimento"))" @onclick:preventDefault>
                    Esqueceu a senha?
                </a>
            </div>

            <!-- Botão Login -->
            <button type="submit" class="btn-login" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner"></span>
                    <span>Entrando...</span>
                }
                else
                {
                    <span>ENTRAR</span>
                }
            </button>

            <!-- Divisor -->
            <div class="divider">
                <span>ou</span>
            </div>

            <!-- Botão Cadastro -->
            <button type="button" 
                    class="btn-register" 
                    @onclick="@(() => ShowAlert("Funcionalidade em desenvolvimento"))"
                    @onclick:preventDefault
                    disabled="@isLoading">
                Cadastre-se
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginRequest loginModel = new();
    private bool isLoading = false;
    private bool showPassword = false;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Verificar se já está autenticado
        var isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            // Já está logado, redirecionar para home
            Navigation.NavigateTo("/home", replace: true);
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleLogin()
    {
        // Limpar erro anterior
        errorMessage = string.Empty;

        // Validação básica
        if (string.IsNullOrWhiteSpace(loginModel.Identifier))
        {
            errorMessage = "Por favor, informe seu e-mail ou telefone";
            return;
        }

        if (string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Por favor, informe sua senha";
            return;
        }

        isLoading = true;

        try
        {
            var response = await AuthService.LoginAsync(loginModel);
            
            // Login bem-sucedido! Navegar para home
            Navigation.NavigateTo("/home", replace: true);
        }
        catch (Exception ex)
        {
            errorMessage = "E-mail/telefone ou senha incorretos";
            Console.WriteLine($"Erro no login: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAlert(string message)
    {
        // TODO: Implementar sistema de alertas/toasts
        Console.WriteLine(message);
    }
}
