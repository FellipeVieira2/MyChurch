@page "/"
@inject NavigationManager Navigation
@inject IAuthService AuthService

<div style="display: flex; align-items: center; justify-content: center; min-height: 100vh;">
    <div style="text-align: center;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
        <p class="mt-3">Verificando autenticação...</p>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100); // Pequeno delay para garantir que tudo carregou
            
            // Verificar se está autenticado
            var isAuthenticated = await AuthService.IsAuthenticatedAsync();
            
            if (isAuthenticated)
            {
                // Já está logado, ir para home
                Navigation.NavigateTo("/home", replace: true);
            }
            else
            {
                // Não está logado, ir para login
                Navigation.NavigateTo("/login", replace: true);
            }
        }
    }
}
